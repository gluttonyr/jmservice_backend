# JM Services backend: copy to .env and fill every value. Never reuse Matistore's values.
NODE_ENV=production
PORT=3000
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=jmservices_db
UPLOAD_ROOT=
# New random secret (e.g. openssl rand -hex 48): Matistore's would let its tokens work here.
JWT_SECRET=
JWT_EXPIRATION=
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_SERVICES_ID=
SERVCUL_API_BASE_URL=
SERVCUL_HASH=
SERVCUL_CASHIER_PASS=
SERVCUL_LOGIN=
SERVCUL_CASHDESK_ID=
SERVCUL_API_TIMEOUT_MS=
# Comma-separated website origins, e.g. https://app.example.com
CORS_ORIGINS=
